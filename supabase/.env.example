# Choose exactly one provider. Store real values only in Supabase Edge Function
# secrets or an ignored local supabase/.env file.
AI_PROVIDER=
AI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Comma-separated production web origins allowed to call browser-facing functions.
# Local Vite origins are allowed automatically. Example: https://app.example.com
APP_ORIGINS=

# Razorpay Edge Function Secrets
# Get your Key ID & Secret from Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret configured under Razorpay Dashboard > Settings > Webhooks
RAZORPAY_WEBHOOK_SECRET=

# Owner emails (receipts, renewal notices, failed-payment notices, plan-ending
# reminders) are sent from support@reviyo.in through the Hostinger mailbox.
# Port 465 (SMTP over TLS): Supabase blocks 25 and 587 for Edge Functions.
# Leave SMTP_PASSWORD empty and no emails are sent.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@reviyo.in
SMTP_PASSWORD=
EMAIL_FROM=Reviyo <support@reviyo.in>

# At least 32 random characters. Send it only from the trusted scheduler in
# the x-cron-secret header; never expose it through a VITE_ variable.
AUTOPAY_CRON_SECRET=
