# Public browser configuration. Copy these names to .env.local and add values
# from your Supabase project Settings > API page.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy projects may use this instead of VITE_SUPABASE_PUBLISHABLE_KEY:
# VITE_SUPABASE_ANON_KEY=

# Razorpay public key for checkout (fallback if not returned by edge function)
VITE_RAZORPAY_KEY_ID=

# Supabase Edge Function Secrets (configured via Supabase CLI or Dashboard > Edge Functions > Secrets)
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
# AUTOPAY_CRON_SECRET=...
